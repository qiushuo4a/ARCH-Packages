# Maintainer: Qiushuo4a <xian@xlnc.company>

pkgname=arcana-world-bin
_pkgname=arcana-world
pkgver=0.4.6
pkgrel=2
arch=('x86_64' 'aarch64')
url="https://github.com/TarocchiLive/arcana-world/releases"
pkgdesc="Bilibili live streaming tool includes  Wayland overlay and text-to-speech helpers"
license=('GPL-3.0') #put "-only" or "-or-later" behind the string and remove this note
# depends=() #Main programme is no DT_NEEDED
optdepends=(
	'pango: native overlay text rendering (pulls glib2/cairo/harfbuzz/fontconfig)'
	'wayland: native overlay Wayland display backend'
	'vulkan-icd-loader: TTS WebGPU acceleration (a Vulkan driver is also needed)'
	'gnome-shell: Qt overlay GNOME window bridge, enable the Arcana Elegant extension'
)
options=('!debug' '!strip')

source_x86_64=(arcana-world-linux-${pkgver}-${pkgrel}-amd64.tar.xz::"https://github.com/TarocchiLive/${_pkgname}/releases/download/v${pkgver}/${_pkgname}-linux-amd64.tar.xz")
source_aarch64=(arcana-world-linux-${pkgver}-${pkgrel}-aarch64.tar.xz::"https://github.com/TarocchiLive/${_pkgname}/releases/download/v${pkgver}/${_pkgname}-linux-arm64.tar.xz")
sha256sums_x86_64=("b1f326e7d2fe58d65e4f0a6c11b01f325139561f54e758c8f901fe7168297c42")
sha256sums_aarch64=("df943480b9b15eb7cc5a6a30d7152abb2f5cec2465cb15284b4ed90051c4cf11")

package() {
	# arcana-world now use more GUI related libs and have a new support to GNOME shell that makes package size larger than ever. After The analysis by GLM-5.3 AI, I noticed These libs are hard to trip off or replace with libs provided by pacman official source with all functions runs well.
	# Maybe we need a new package arcana-world-lite which keeps TUI interface and simple overlay support like version 2.x

	mkdir -p ${pkgdir}/usr/lib/${_pkgname}/ ${pkgdir}/usr/bin/
	cp -r $srcdir/arcana-world ${srcdir}/libexec/ ${pkgdir}/usr/lib/${_pkgname}/
	ln -s /usr/lib/${_pkgname}/arcana-world ${pkgdir}/usr/bin/arcana-world

	install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
