

# Maintainer: Qiushuo4a <xian@xlnc.company>
# Source (repo) Maintainer:
pkgname=obs-audio-wave-plugin-xlnc
_pkgname=audio-wave
pkgver=3.1.0
pkgrel=1
epoch=
pkgdesc="obs plugin composite-blur"
arch=('x86_64')
depends=('obs-studio')
url="https://github.com/mmlTools/audio-wave"
license=('GPL-2.0')
options=('!debug' '!strip') #debug->启用debug !strip->禁用调试符号

source=("${url}/releases/download/${pkgver}/${_pkgname}-${pkgver}-x86_64-linux-gnu.deb")  #source 只能是文件 同级目录可以省略路径 开始后makepkg会将所有的source文件copy到$srcdir/中
sha256sums=('219c928451ffa4dc4b7976f1db62089a63ac7137058729c69ae53669f93b366b')



package() {
	cd "$srcdir"

	##---- BEGIN 1.DEB 包打包实例
	# data.tar.xz 内含 ./usr/ 目录,直接解压到 pkgdir 即完成安装布局
	tar -xf "$srcdir/data.tar.gz" -C "$pkgdir" --no-same-owner

	#WARNING: The File Directory is in old styled version, obs-studio will remove the support to this directory !
	#更新目录 Dir UPDATE
	mv $pkgdir/usr/lib/x86_64-linux-gnu/obs-plugins/ $pkgdir/usr/lib/obs-plugins/
	rm -r $pkgdir/usr/lib/x86_64-linux-gnu/

	# 修正权限:目录 0755,普通数据 0644
	find "$pkgdir" -type f -exec chmod 0644 {} +
	find "$pkgdir" -type d -exec chmod 0755 {} +
	#使用 install -Dm 命令处理资源文件会更好 解压时保留权限也会更轻松
	##---- END 1
}
